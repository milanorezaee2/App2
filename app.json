{
  "expo": {
    "name": "MiloMultiLanguage",
    "slug": "companion-english",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "companionenglish",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.devicecontrol.companion",
      "versionCode": 200,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withStableLayoutDirection",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Vazir",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/400Regular/Vazirmatn_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Vazir-Medium",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/500Medium/Vazirmatn_500Medium.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Vazir-Bold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/700Bold/Vazirmatn_700Bold.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Vazir-Black",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/900Black/Vazirmatn_900Black.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Inter-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Inter-ExtraBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Lalezar",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/400Regular/Vazirmatn_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Vazirmatn",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/400Regular/Vazirmatn_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Vazirmatn-Medium",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/500Medium/Vazirmatn_500Medium.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Vazirmatn-Bold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/vazirmatn/700Bold/Vazirmatn_700Bold.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2878DE",
          "defaultChannel": "milo-chat"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "برای بازکردن قفل برنامه، اجازه استفاده از Face ID را بدهید."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAFF",
          "image": "./assets/images/splash-learning-light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F5FAFF",
            "image": "./assets/images/splash-learning-light.png"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "برای تمرین تلفظ جمله‌ها، اجازه استفاده از میکروفن را بدهید."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ],
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjsc.so",
                "**/libfbjni.so"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/App2",
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "sitemap": false
      }
    }
  }
}
