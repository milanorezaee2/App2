EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Lesson narrator (English, German, Russian).
# auto  = use the cloud narrator when the narration-tts function is deployed,
#         otherwise the best neural female voice installed on the device.
# off   = device voices only (no network call, no cost).
# on    = same as auto but never silence the cloud attempt.
EXPO_PUBLIC_NARRATOR_CLOUD=auto
# Optional override; by default it is derived from EXPO_PUBLIC_SUPABASE_URL.
# EXPO_PUBLIC_NARRATION_TTS_URL=https://YOUR_PROJECT.supabase.co/functions/v1/narration-tts
# Optional shared token; set the same value as the NARRATION_TTS_TOKEN secret.
# EXPO_PUBLIC_NARRATION_TTS_TOKEN=

# Development preview only. Keep false for production APK builds.
EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING=false

# Required for production calls and screen viewing across different networks.
# Provide both UDP/TCP TURN and TLS TURN endpoints, separated by commas.
EXPO_PUBLIC_TURN_URLS=turn:your-turn.example.com:3478?transport=udp,turn:your-turn.example.com:3478?transport=tcp,turns:your-turn.example.com:5349?transport=tcp
EXPO_PUBLIC_TURN_USERNAME=your-short-lived-turn-username
EXPO_PUBLIC_TURN_CREDENTIAL=your-short-lived-turn-credential

# Hidden by default. Also requires the trusted server-side education feature switch.
EXPO_PUBLIC_ENABLE_EDUCATION_ADMIN=false
