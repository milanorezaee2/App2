{
  "name": "companion-english",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 node scripts/run-expo.mjs start",
    "dev:web": "PORT=8081 node scripts/serve-preview.mjs",
    "build:web": "node scripts/run-expo.mjs export --platform web --clear",
    "serve:web": "PORT=8081 node scripts/serve-preview.mjs",
    "preview:web": "PORT=8081 node scripts/serve-preview.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-course-content.mjs",
    "android": "node scripts/run-expo.mjs run:android",
    "ios": "node scripts/run-expo.mjs run:ios",
    "validate:logic": "node scripts/verify-app-logic.mjs",
    "validate:narrator": "node scripts/verify-narrator.mjs",
    "validate:admin": "node scripts/verify-education-admin.mjs",
    "validate:a1": "node scripts/verify-a1-editorial.cjs",
    "validate:german-levels": "node scripts/verify-german-completion.cjs",
    "validate:russian": "node scripts/verify-russian-course.cjs",
    "validate:russian-architecture": "node scripts/verify-russian-architecture.cjs",
    "validate:english-supplement": "node scripts/verify-english-supplement.cjs",
    "validate:english-engine": "node scripts/verify-english-engine.cjs",
    "validate:placement": "node scripts/verify-placement.cjs",
    "validate:speech-policy": "node scripts/verify-speech-policy.mjs",
    "validate:russian-voice": "node scripts/verify-russian-voice.mjs",
    "validate:app-lock": "node scripts/verify-app-lock.mjs",
    "validate:typography": "node scripts/verify-typography-stability.mjs",
    "validate:chat-notifications": "node scripts/verify-chat-notifications.mjs",
    "validate:registration-admin": "node scripts/verify-registration-admin.mjs",
    "validate:requested-updates": "node scripts/verify-requested-updates.mjs",
    "validate:backup": "node scripts/verify-english-backup.mjs",
    "validate:a11y": "node scripts/verify-accessibility-static.mjs",
    "validate:pronunciation": "node scripts/verify-pronunciation-course.mjs",
    "validate:personal-sync": "node scripts/verify-personal-sync.mjs",
    "validate:english-four": "node scripts/verify-english-four.cjs",
    "prebuild:web": "node scripts/check-public-connection.mjs",
    "narration:manifest": "node scripts/export-narration-manifest.mjs",
    "narration:generate": "node scripts/generate-narration.mjs",
    "narration:check": "ffprobe -v error -show_entries format=duration,size -of default=noprint_wrappers=1 generated-audio/**/*.mp3"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
