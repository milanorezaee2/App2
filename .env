EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Lesson narrator (English, German, Russian) — human cloud voice, no device TTS.
EXPO_PUBLIC_NARRATOR_CLOUD=on
# The narration-tts Edge Function is derived automatically from SUPABASE_URL:
#   https://your-project.supabase.co/functions/v1/narration-tts
# Optional shared token; set the same value as the NARRATION_TTS_TOKEN secret.
# EXPO_PUBLIC_NARRATION_TTS_TOKEN=
